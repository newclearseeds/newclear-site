{
  // Must match the Worker name in the Cloudflare dashboard (Workers Builds →
  // Settings). Rename this if the existing project is not called newclear-site.
  "name": "newclear-site",
  // Newest date supported by Wrangler 4.156.0 (the wrangler npx resolves today).
  "compatibility_date": "2026-10-30",
  "assets": {
    // Repo root is the site. Files that are not part of the site are listed in
    // .assetsignore. There is no Worker script: this is static assets only.
    "directory": "./",
    // Keep /page.html addresses as they are on GitHub Pages. The default
    // auto-trailing-slash mode would 307 those to /page.
    "html_handling": "none",
    // Unknown paths serve the existing 404.html with a 404 status.
    "not_found_handling": "404-page"
  }
}
